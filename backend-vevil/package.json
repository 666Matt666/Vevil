{
  "name": "backend-vevil",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "node node_modules/@nestjs/cli/bin/nest.js build",
    "start": "node dist/src/main.js",
    "start:dev": "nest start --watch --preserveWatchOutput -r tsconfig-paths/register",
    "start:prod": "node dist/src/main.js",
    "seed:examples": "ts-node -r tsconfig-paths/register src/scripts/seed-example-data.ts",
    "seed:production": "ts-node -r tsconfig-paths/register src/scripts/seed.ts",
    "db:copy-local-to-supabase": "ts-node -r tsconfig-paths/register src/scripts/copy-local-to-supabase.ts",
    "create:admin": "ts-node -r tsconfig-paths/register src/scripts/create-admin-user.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "migration:generate": "npm run build && npx typeorm migration:generate ./src/migrations/Initial -d ./dist/src/data-source.js",
    "migration:run": "npm run build && npx typeorm migration:run -d ./dist/src/data-source.js",
    "migration:run:prod": "npx typeorm migration:run -d ./dist/src/data-source.js",
    "migration:revert": "npx typeorm migration:revert -d ./dist/src/data-source.js"
  },
  "dependencies": {
    "@nestjs-modules/mailer": "^2.0.2",
    "@nestjs/cache-manager": "^3.0.1",
    "@nestjs/common": "^10.4.20",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^10.4.20",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/passport": "^11.0.5",
    "@nestjs/platform-express": "^10.4.20",
    "@nestjs/serve-static": "^4.0.0",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/throttler": "^6.5.0",
    "@nestjs/typeorm": "^10.0.2",
    "@simplewebauthn/server": "^13.3.0",
    "@types/passport-jwt": "^4.0.1",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "nodemailer": "^8.0.2",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.16.3",
    "reflect-metadata": "^0.2.2",
    "swagger-ui-express": "^5.0.1",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.12",
    "@nestjs/schematics": "^10.1.3",
    "@nestjs/testing": "^10.3.10",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.0.0",
    "@types/nodemailer": "^7.0.11",
    "@types/passport-local": "^1.0.38",
    "@types/supertest": "^6.0.3",
    "dotenv": "^17.3.1",
    "jest": "^29.5.12",
    "rimraf": "^6.1.2",
    "supertest": "^7.0.0",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~5.4.5"
  }
}
