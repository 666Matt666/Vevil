# Copiá este archivo a .env.local para desarrollo en tu PC con Postgres local.
# .env.local no se sube a git (está en .gitignore).
#
# Con .env.local así, el backend usa PostgreSQL del docker-compose (vevil-system/docker-compose.yml).
# Si además tenés .env con Supabase, .env.local sobreescribe estas variables.

DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=admin
DB_DATABASE=vevil_db

# ----- Opcional: correo (recordatorios, recuperar contraseña, registro) -----
# Descomentá las líneas de abajo y reemplazá con tu email admin y SMTP.
# Los emails se envían solo si MAIL_HOST está definido; si no, en desarrollo se loguean en consola.
MAIL_ADMIN_EMAIL=admin@vevil.com
MAIL_ADMIN_NAME=Vevil Admin
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=tu-email@gmail.com
# MAIL_PASSWORD=tu-contraseña-de-app
